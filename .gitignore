# -----------------------------------------------------------
# 1. 编译产生的中间文件 (不管它们在哪个子文件夹，统统忽略)
# -----------------------------------------------------------
*.o        # 目标文件
*.d        # 依赖文件
*.crf      # 交叉引用文件
*.lnp      # 链接参数
*.lst      # 列表文件
*.map      # 内存映射
*.dep      # 依赖信息
*.sct      # 分散加载
*.scvd     # 系统查看数据
*.htm      # 编译报告网页
*.axf      # 调试文件

# -----------------------------------------------------------
# 2. 生成的固件文件 (通常不需要上传，除非为了归档)
# -----------------------------------------------------------
*.hex
*.bin
*.elf

# -----------------------------------------------------------
# 3. Keil IDE 的个人配置 (避免覆盖别人的窗口布局设置)
# -----------------------------------------------------------
*.uvguix.*
*.uvoptx
*.uvprojx.user

# -----------------------------------------------------------
# 4. 专门针对你截图中的特定文件夹结构
# -----------------------------------------------------------
# 忽略 Listings 和 Objects 文件夹（如果以后你设置了输出目录）
MDK-ARM/Listings/
MDK-ARM/Objects/

# 忽略 DebugConfig 文件夹
MDK-ARM/DebugConfig/


MDK-ARM/**/*.o
MDK-ARM/**/*.d
MDK-ARM/**/*.crf
MDK-ARM/**/*.lst
MDK-ARM/**/*.map
MDK-ARM/**/*.axf
MDK-ARM/**/*.htm

*.lnp
*.dep
ExtDll.iex
build_log.txt
